# Server Port (1-65535, defaults to 5000)
PORT=5000

# Environment Mode (development | production | test, defaults to development)
NODE_ENV=development

# MongoDB Connection URI (required for development/production)
MONGODB_URI=mongodb://localhost:27017/workspace

# MongoDB Test Database Connection URI (required for automated test isolation)
MONGODB_TEST_URI=mongodb://localhost:27017/workspace_test

# JWT Authentication Secret (required, min 16 chars in dev, min 32 chars in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated list of allowed web origins, e.g. https://app.example.com)
# Defaults to localhost dev ports (5173, 5000) when omitted. Wildcard '*' is forbidden in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Rate Limiting Configuration (requests per 15-minute window per IP)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_API_MAX=300

# Initial Admin Bootstrap (used by npm run seed:admin)
ADMIN_EMAIL=admin0@gmail.com
ADMIN_PASSWORD=Pass123!
ADMIN_NAME=Workspace Admin0
